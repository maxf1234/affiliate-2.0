{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/share/deal/:id",
      "destination": "/api/deal?id=:id"
    },
    {
      "source": "/student-trial",
      "destination": "/api/student-trial"
    },
    {
      "source": "/free-trial",
      "destination": "/api/free-trial"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
